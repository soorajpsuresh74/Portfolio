{
  "kind": "singleType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile",
    "description": "Name, contact details, the text sections of the portfolio, and resume content"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "address": {
      "type": "text",
      "maxLength": 300
    },
    "resumeUrl": {
      "type": "string",
      "maxLength": 500
    },
    "linkedinUrl": {
      "type": "string",
      "maxLength": 500
    },
    "githubUrl": {
      "type": "string",
      "maxLength": 500
    },
    "heroEyebrow": {
      "type": "string",
      "maxLength": 60
    },
    "heroEyebrowAction": {
      "type": "string",
      "maxLength": 60
    },
    "heroHeadline": {
      "type": "string",
      "maxLength": 160
    },
    "heroAccent": {
      "type": "string",
      "maxLength": 40
    },
    "heroSub": {
      "type": "text",
      "maxLength": 800
    },
    "about": {
      "type": "text",
      "maxLength": 3000
    },
    "focusIntro": {
      "type": "text",
      "maxLength": 1000
    },
    "focusItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.focus-item"
    },
    "contactHeadline": {
      "type": "string",
      "maxLength": 160
    },
    "resumeSummary": {
      "type": "text",
      "maxLength": 1500
    },
    "keyCompetencies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item"
    },
    "experience": {
      "type": "component",
      "repeatable": true,
      "component": "resume.experience"
    },
    "education": {
      "type": "component",
      "repeatable": true,
      "component": "resume.education"
    },
    "activities": {
      "type": "component",
      "repeatable": true,
      "component": "resume.activity"
    }
  }
}
